import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { resolve } from "node:path";
process.env.QATOOLS_DB = resolve(mkdtempSync(resolve(tmpdir(), "probef2-")), "p.db");
const { buildApp } = await import("./src/server.js");
const app = await buildApp({ logger: false });
await app.ready();
const mk = async (url, payload) => JSON.parse((await app.inject({ method: "POST", url, payload })).body);
const p = await mk("/api/projects", { key: "P", name: "P", target_url: "https://shop.example.test" });
const pid = p.data.id;
const tc = await mk(`/api/projects/${pid}/testcases`, { code: "TC-001", title: "Judul", type: "functional", layer: "api", priority: "high", severity: "major", automation_status: "to_be_automated", engine: "api", status: "ready" });
const col = await mk(`/api/projects/${pid}/collections`, { name: "Auth API", base_url: "https://api.example.test" });
await mk(`/api/collections/${col.data.id}/requests`, { test_case_id: tc.data.id, name: "POST /auth/login", method: "POST", path: "/auth/login", headers: {"X-Tenant":"acme"}, query: {verbose:"1"}, body: JSON.stringify({email:"a@b.c"}), body_type: "json", assertions: [{source:"status",operator:"equals",expected:200},{source:"jsonpath",path:"$.data.token",operator:"exists"}] });
const gen = await mk(`/api/projects/${pid}/codegen`, { framework: "rest-assured", base_url: "https://shop.example.test" });
for (const f of gen.data.files) console.log("FILE:", f.path);
console.log("=== ApiTest.java ===");
console.log(gen.data.files.find(f=>f.path.endsWith("ApiTest.java"))?.content);
await app.close();
