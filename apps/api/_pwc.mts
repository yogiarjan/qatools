import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { resolve } from "node:path";
process.env.QATOOLS_DB = resolve(mkdtempSync(resolve(tmpdir(), "pw3-")), "p.db");
const { buildApp } = await import("./src/server.js");
const app = await buildApp({ logger: false });
await app.ready();
const J = async (m,url,p) => { const r = await app.inject({ method:m, url, ...(p?{payload:p}:{}) }); return { s:r.statusCode, b:r.body?JSON.parse(r.body):null }; };
const p = await J("POST","/api/projects",{key:"P",name:"P",target_url:"https://shop.example.test"});
const pid=p.b.data.id;
const wc=await J("POST",`/api/projects/${pid}/testcases`,{code:"TC-001",title:"Login",type:"functional",layer:"web",priority:"high",severity:"major",automation_status:"to_be_automated",engine:"web",status:"ready"});
await J("POST",`/api/projects/${pid}/web-flows`,{test_case_id:wc.b.data.id,name:"Login Flow",start_url:"https://shop.example.test/login",steps:[{action:"goto",value:"https://shop.example.test/login"},{action:"click",selector:"#go"}]});
const g = await J("POST",`/api/projects/${pid}/codegen`,{framework:"playwright",base_url:"https://shop.example.test"});
const fx = g.b.data.files.find(f=>f.path==="fixtures/qa.fixture.ts");
console.log("=== quote-undefined matches in fixtures/qa.fixture.ts ===");
for (const [i,l] of fx.content.split("\n").entries()) if (/(['"`])undefined\1/.test(l)) console.log(i+1, JSON.stringify(l));
console.log("=== web.spec.ts ===");
console.log(g.b.data.files.find(f=>f.path==="tests/web.spec.ts").content);
await app.close();
