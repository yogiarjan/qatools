import { mkdtempSync } from "node:fs";
import { tmpdir } from "node:os";
import { resolve } from "node:path";
process.env.QATOOLS_DB = resolve(mkdtempSync(resolve(tmpdir(), "probef6-")), "p.db");
const { buildApp } = await import("./src/server.js");
const { db } = await import("./src/db/index.js");
const app = await buildApp({ logger: false });
await app.ready();
const mk = async (url, payload) => { const r = await app.inject({ method: "POST", url, payload }); return { s: r.statusCode, b: JSON.parse(r.body) }; };
const p = await mk("/api/projects", { key: "P", name: "P" });
const pid = p.b.data.id;
const dc = await mk(`/api/projects/${pid}/testcases`, { code: "TC-004", title: "Db", type: "functional", layer: "db", priority: "medium", severity: "major", automation_status: "to_be_automated", engine: "db", status: "ready" });
console.log("case:", dc.s, dc.b.data?.id);
const conn = await mk(`/api/projects/${pid}/db-connections`, { name: "Q", dialect: "sqlite", dsn: "sqlite:///x.db" });
console.log("conn:", conn.s, JSON.stringify(conn.b).slice(0,300));
const chk = await mk(`/api/db-checks`, { connection_id: conn.b.data?.id, test_case_id: dc.b.data?.id, name: "Active users count", sql: 'SELECT COUNT(*) AS n FROM users WHERE status = "active"', assertions: [{source:"row_count",operator:"gte",expected:1}] });
console.log("check:", chk.s, JSON.stringify(chk.b).slice(0,400));
console.log("rows in db:", JSON.stringify(db.prepare("SELECT id, test_case_id, project_id FROM db_checks").all()));
await app.close();
